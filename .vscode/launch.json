{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "تشغيل اتزان (Flask)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "تشغيل الاختبارات",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "tests", "-v"],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
